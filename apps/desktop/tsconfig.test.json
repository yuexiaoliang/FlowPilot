{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom",
      "@playwright/test"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/renderer/test/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vite.config.mts"
  ]
}
